<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    
    <!-- LEFT BAR -->
    <ImageView
        android:id="@+id/leftBar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:scaleType="centerCrop"/>

    <!-- RIGHT BAR -->
    <ImageView
        android:id="@+id/rightBar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:scaleType="centerCrop"/>

    <ImageView
        android:id="@+id/censor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:scaleType="centerCrop"/>

    <RelativeLayout
        android:id="@+id/touchScreenController"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!-- LEFT MENU PANEL -->
        <LinearLayout
            android:id="@+id/leftPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_margin="20dp"
            android:orientation="vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/btnEsc"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:text="ESC"
                android:textAllCaps="false"
                android:background="@drawable/material_button"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp"/>

            <Button
                android:id="@+id/btnMenu"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:text="SET"
                android:textAllCaps="false"
                android:background="@drawable/material_button"/>

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp"/>

            <Button
                android:id="@+id/btnJoyPad"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:text="PAD"
                android:textAllCaps="false"
                android:background="@drawable/material_button"/>

        </LinearLayout>

        <!-- JOYSTICK -->
        <FrameLayout
            android:id="@+id/joystickPanel"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="20dp"
            android:padding="10dp"
            android:background="@drawable/material_panel">

            <com.th06.game.JoystickView
                android:id="@+id/joystick"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </FrameLayout>


        <!-- D PAD -->
        <GridLayout
            android:id="@+id/padPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:padding="12dp"
            android:rowCount="3"
            android:columnCount="3"
            android:background="@drawable/material_panel">


            <Button
                android:id="@+id/up_left"
                android:text="↖"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/material_button"/>

            <Button
                android:id="@+id/up"
                android:text="↑"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/material_button"/>

            <Button
                android:id="@+id/up_right"
                android:text="↗"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/material_button"/>


            <Button
                android:id="@+id/left"
                android:text="←"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/material_button"/>

            <Space
                android:layout_width="52dp"
                android:layout_height="52dp"/>

            <Button
                android:id="@+id/right"
                android:text="→"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/material_button"/>


            <Button
                android:id="@+id/down_left"
                android:text="↙"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/material_button"/>

            <Button
                android:id="@+id/down"
                android:text="↓"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/material_button"/>

            <Button
                android:id="@+id/down_right"
                android:text="↘"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/material_button"/>

        </GridLayout>

    <Button
        android:id="@+id/zSticky"
        android:layout_width="110dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:text="Z Sticky"
        android:textAllCaps="false"
        android:background="@drawable/material_button"/>

    <Button
        android:id="@+id/btnZ"
        android:layout_width="104dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="160dp"
        android:background="@drawable/material_button"
        android:text="Z"/>

    <Button
        android:id="@+id/btnX"
        android:layout_width="104dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/material_button"
        android:text="X"/>

    <Button
        android:id="@+id/btnShift"
        android:layout_width="104dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/material_button"
        android:text="SHIFT"/>
    </RelativeLayout>
</RelativeLayout>